# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (fake test banks) or production (your real banks)
PLAID_ENV=sandbox

# A long random string. The app sends it with every request so nobody else can use your server.
APP_API_KEY=change-me-to-a-long-random-string

PORT=8080
